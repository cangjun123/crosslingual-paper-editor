OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4.1
HOST=127.0.0.1
PORT=3001

# Docker Compose host publishing (not used by the Node process directly)
APP_BIND_IP=0.0.0.0
APP_PORT=3001

# Optional for Docker builds where the official npm registry is unavailable
# NPM_REGISTRY=https://registry.npmmirror.com
